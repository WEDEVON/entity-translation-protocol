{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/translate_process/prompts/schema.json",
  "title": "Translate Process Prompt Manifest",
  "description": "Schema for the machine-readable prompt manifest used by translate_process.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "package_version",
    "package_name",
    "description",
    "prompt_sequence",
    "prompts"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "description": "Schema-facing version for the manifest format."
    },
    "package_version": {
      "type": "string",
      "description": "Repository package version that this manifest corresponds to."
    },
    "package_name": {
      "type": "string",
      "const": "translate_process"
    },
    "description": {
      "type": "string"
    },
    "prompt_sequence": {
      "type": "array",
      "description": "Ordered execution sequence for prompt stages.",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{2}-[a-z0-9-]+$"
      },
      "uniqueItems": true
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/promptEntry"
      }
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "promptEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "title",
        "stage",
        "required_inputs",
        "required_outputs",
        "completion_criteria"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9]{2}-[a-z0-9-]+$"
        },
        "path": {
          "type": "string",
          "pattern": "^prompts\\/[0-9]{2}-[a-z0-9-]+\\.md$"
        },
        "title": {
          "type": "string"
        },
        "stage": {
          "type": "string",
          "enum": [
            "setup",
            "policy",
            "audit",
            "manual_review",
            "promotion",
            "review",
            "release"
          ]
        },
        "required_inputs": {
          "$ref": "#/$defs/stringList"
        },
        "required_outputs": {
          "$ref": "#/$defs/stringList"
        },
        "completion_criteria": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}
